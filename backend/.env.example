# TARS Backend Environment Variables

# LLM Provider API Keys (至少配置一个)
# ============================================
# OpenRouter (推荐，默认，支持多种模型)
# OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Anthropic (Claude 系列)
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI (GPT 系列)
# OPENAI_API_KEY=sk-your-key-here

# ============================================
# 可选配置
# ============================================

# 数据目录 (默认: ~/.tars)
# TARS_DATA_DIR=~/.tars

# 服务地址和端口 (默认: 0.0.0.0:8000)
# TARS_HOST=0.0.0.0
# TARS_PORT=8000

# 日志级别 (默认: INFO)
# LOG_LEVEL=INFO

# 天气 API Key (可选，用于天气查询技能)
# OPENWEATHER_API_KEY=your-openweather-api-key

# InsightForge / BI 本地开发：允许连接 localhost / 内网数据库（生产环境勿开启）
# TARS_INSIGHT_ALLOW_PRIVATE_HOSTS=1
