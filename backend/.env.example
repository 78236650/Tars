# TARS Backend Environment Variables

# LLM Provider API Keys (至少配置一个)
# ============================================
# OpenRouter (推荐，默认，支持多种模型)
# OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Anthropic (Claude 系列)
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI (GPT 系列)
# OPENAI_API_KEY=sk-your-key-here

# ============================================
# 可选配置
# ============================================

# 数据目录 (默认: ~/.tars)
# TARS_DATA_DIR=~/.tars

# 服务地址和端口 (默认: 0.0.0.0:8000)
# TARS_HOST=0.0.0.0
# TARS_PORT=8000

# 日志级别 (默认: INFO)
# LOG_LEVEL=INFO

# 天气 API Key (可选，用于天气查询技能)
# OPENWEATHER_API_KEY=your-openweather-api-key

# InsightForge / BI 本地开发：允许连接 localhost / 内网数据库（生产环境勿开启）
# TARS_INSIGHT_ALLOW_PRIVATE_HOSTS=1

# Ollama 本地模型（TARS 设置里切换 Ollama 后生效）
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:8b
# 27B 等大模型：降低上下文，避免 24GB 内存 OOM；工具轮次关闭 thinking
# OLLAMA_NUM_CTX=16384
# OLLAMA_NUM_PREDICT_TOOLS=4096
# TARS_LLM_STALL_TIMEOUT=60
# TARS_LLM_STALL_TIMEOUT_LARGE=180
