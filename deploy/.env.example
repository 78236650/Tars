# deploy/docker-compose.yml — copy to deploy/.env
# cp .env.example .env && docker compose up -d --build

# ── Ports ────────────────────────────────────────────────────────────
TARS_BACKEND_PORT=8000
TARS_FRONTEND_PORT=8080

# ── PostgreSQL credentials ───────────────────────────────────────────
PG_USER=tars
PG_PASSWORD=tars
PG_DATABASE=tars
DATABASE_URL=postgresql://${PG_USER}:${PG_PASSWORD}@postgres:5432/${PG_DATABASE}
TARS_PG_POOL_MAX=10

# ── JWT auth (REQUIRED in production — generate with: openssl rand -hex 32) ──
TARS_JWT_SECRET=change-me-in-production

# ── ChromaDB vector store ────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ── LLM provider ─────────────────────────────────────────────────────
# Ollama (local GPU server — Linux: use host IP, macOS/Windows: host.docker.internal)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b

# DeepSeek API (cloud)
# DEEPSEEK_API_KEY=sk-...

# OpenRouter (multi-provider)
# OPENROUTER_API_KEY=sk-or-...

# ── Insight multi-instance (optional) ─────────────────────────────────
# TARS_SSE_STICKY=1

# ── File upload (optional) ───────────────────────────────────────────
# TARS_MAX_UPLOAD_MB=50
