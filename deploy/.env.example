# deploy/docker-compose.yml — copy to deploy/.env

TARS_BACKEND_PORT=8000
TARS_FRONTEND_PORT=8080

# PostgreSQL (backend uses DATABASE_URL; compose sets postgres service URL)
DATABASE_URL=postgresql://tars:tars@postgres:5432/tars
TARS_PG_POOL_MAX=10

# JWT auth (required in production — generate a long random secret)
TARS_JWT_SECRET=change-me-in-production

# LLM (passed to backend container)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=

# Insight multi-instance (optional)
# TARS_SSE_STICKY=1
