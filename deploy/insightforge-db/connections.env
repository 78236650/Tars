# InsightForge 本地 Docker 测试库 — TARS bi_datasources 连接串
# 复制到 BI 工作台添加数据源，或 source 后使用

# MySQL 8
INSIGHT_MYSQL_NAME=鉴数Demo-MySQL
INSIGHT_MYSQL_DB_TYPE=mysql
INSIGHT_MYSQL_URL=mysql+pymysql://insight:insight_pass@127.0.0.1:3307/insight_demo

# PostgreSQL 16
INSIGHT_PG_NAME=鉴数Demo-PostgreSQL
INSIGHT_PG_DB_TYPE=postgresql
INSIGHT_PG_URL=postgresql+psycopg2://insight:insight_pass@127.0.0.1:5433/insight_demo

# Oracle Free 23 (用户 insight / insight_pass)
INSIGHT_ORACLE_NAME=鉴数Demo-Oracle
INSIGHT_ORACLE_DB_TYPE=oracle
# 需安装 oracledb 或 cx_Oracle；若 thin 模式：
INSIGHT_ORACLE_URL=oracle+oracledb://insight:insight_pass@127.0.0.1:1521/?service_name=FREE

# Apache Doris 3 (MySQL 协议，db_type 填 doris)
INSIGHT_DORIS_NAME=鉴数Demo-Doris
INSIGHT_DORIS_DB_TYPE=doris
INSIGHT_DORIS_URL=mysql+pymysql://root@127.0.0.1:9030/insight_demo

# JDBC 降级模式测试：与 MySQL 相同实例，db_type 填 jdbc
INSIGHT_JDBC_NAME=鉴数Demo-JDBC-generic
INSIGHT_JDBC_DB_TYPE=jdbc
INSIGHT_JDBC_URL=mysql+pymysql://insight:insight_pass@127.0.0.1:3307/insight_demo

