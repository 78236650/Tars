# TARS 环境变量模板
# 复制此文件为 .env 并填入实际值

# ========== LLM Provider 配置 ==========
# 选择 provider: ollama 或 openrouter
LLM_PROVIDER=ollama

# Ollama 本地模型 (默认)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenRouter (可选)
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Anthropic Claude (可选)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI GPT (可选)
# OPENAI_API_KEY=your_openai_api_key_here

# ========== 服务器配置 ==========
TARS_HOST=0.0.0.0
TARS_PORT=8000
TARS_DATA_DIR=~/.tars

# ========== 安全配置 ==========
# 用于身份验证的 API Key (可选)
# TARS_API_KEY=your_secure_api_key_here
